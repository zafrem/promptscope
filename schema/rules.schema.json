{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zafrem/promptscope/schema/rules.schema.json",
  "title": "promptscope rule set",
  "type": "object",
  "required": ["version", "rules"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "Rule set version, reported by Engine.RulesVersion().",
      "minLength": 1
    },
    "pack": {
      "type": "string",
      "description": "Optional pack name, e.g. baseline or a forge-produced private pack.",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "category", "applies_to", "kind", "patterns", "weight"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{2,6}-[0-9]{3,4}$"
        },
        "category": {
          "enum": [
            "instruction_override",
            "delimiter_escape",
            "obfuscation",
            "invisible_char",
            "boundary_violation",
            "template_bleed",
            "unexpected_script",
            "homoglyph"
          ]
        },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["prompt", "context", "output"] }
        },
        "kind": { "enum": ["literal", "regex", "charclass"] },
        "patterns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "action": {
          "enum": ["strip_match", "strip_line", "strip_block"],
          "default": "strip_match"
        },
        "enabled": { "type": "boolean", "default": true },
        "description": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "charclass" } } },
          "then": {
            "properties": {
              "patterns": {
                "items": { "pattern": "^U\\+[0-9A-Fa-f]{4,6}(-U\\+[0-9A-Fa-f]{4,6})?$" }
              }
            }
          }
        }
      ]
    }
  }
}
